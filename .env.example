# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string

# JWT Secret (for signing authentication tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER use a short or predictable value. Minimum 32 random characters.
JWT_SECRET=your_jwt_secret_key_minimum_32_chars

# Cloudinary Configuration (server-side only — never expose to client)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Upstash Redis (for production rate limiting — brute-force & abuse protection)
# Create a free database at: https://upstash.com
# Without these, rate limiting is DISABLED and your login endpoint is vulnerable to brute-force.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Node Environment
NODE_ENV=production
